{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" -I -X utf8 \"<DW>/tools/hook_guard.py\" --rules \"<DW>/tools/guard_rules.json\" --profile worker --pause-flag \"<PAUSE_FLAG>\" --audit \"<AUDIT_LOG>\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" -I -X utf8 \"<DW>/tools/audit_log.py\" append --log \"<AUDIT_LOG>\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" -I -X utf8 \"<DW>/tools/audit_log.py\" append --log \"<AUDIT_LOG>\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git send-pack *)",
      "PowerShell(git send-pack *)",
      "Bash(git http-push *)",
      "PowerShell(git http-push *)",
      "Bash(gh repo sync *)",
      "PowerShell(gh repo sync *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "PowerShell(Remove-Item *)",
      "mcp__*__delete_*",
      "mcp__*__trash_*",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(gh repo create *)",
      "Bash(npm publish *)",
      "Bash(cargo publish *)",
      "Bash(twine upload *)",
      "Bash(docker push *)",
      "mcp__*__buy_*",
      "mcp__*__purchase_*",
      "mcp__*__checkout*",
      "Edit(~/.claude/settings*.json)",
      "Edit(//**/.claude/settings*.json)",
      "Edit(//**/managed-settings.json)",
      "Edit(//**/CLAUDE.md)",
      "Edit(//**/CLAUDE.local.md)",
      "Edit(~/.claude.json)",
      "Edit(//**/.mcp.json)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(setx *)",
      "PowerShell(setx *)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/AppData/Roaming/GitHub CLI/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": []
  },
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  }
}
